{
  "version": "7.3",
  "screens": [
    {
      "id": "CATALOG_SCREEN",
      "title": "Catálogo Ferretería",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Selecciona tus Productos 🛠️"
          },
          {
            "type": "TextSubheading",
            "text": "Elige la categoría y los artículos que deseas adquirir:"
          },
          {
            "type": "Dropdown",
            "name": "categoria",
            "label": "Categoría",
            "required": true,
            "data-source": [
              {
                "id": "herramientas",
                "title": "⚡ Herramientas"
              },
              {
                "id": "construccion",
                "title": "🧱 Construcción"
              },
              {
                "id": "pinturas",
                "title": "🎨 Pinturas"
              },
              {
                "id": "plomeria",
                "title": "🚿 Plomería"
              },
              {
                "id": "electricidad",
                "title": "💡 Electricidad"
              }
            ]
          },
          {
            "type": "CheckboxGroup",
            "name": "productos_seleccionados",
            "label": "Productos Populares",
            "required": true,
            "data-source": [
              {
                "id": "HER-TAL-001",
                "title": "Taladro DeWalt 20V",
                "description": "$135.00 • 2 baterías de litio"
              },
              {
                "id": "HER-AMO-002",
                "title": "Amoladora Bosch 4-1/2",
                "description": "$68.50 • 850W con disco"
              },
              {
                "id": "CON-CEM-001",
                "title": "Cemento Selvalegre 50kg",
                "description": "$8.75 • Tipo Portland"
              },
              {
                "id": "CON-CAR-002",
                "title": "Carretilla Tolva 90L",
                "description": "$62.00 • Reforzada"
              },
              {
                "id": "PIN-LAT-001",
                "title": "Pintura Látex Vinilac",
                "description": "$28.00 • Galón blanco lavable"
              },
              {
                "id": "PLO-TUB-001",
                "title": "Tubo PVC Presión 1/2",
                "description": "$5.20 • Tira de 6 metros"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continuar al Pedido",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "CHECKOUT_SCREEN"
              },
              "payload": {
                "categoria": "${form.categoria}",
                "productos": "${form.productos_seleccionados}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CHECKOUT_SCREEN",
      "title": "Datos de Entrega y Pago",
      "terminal": true,
      "data": {
        "categoria": {
          "type": "string",
          "__example__": "herramientas"
        },
        "productos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": [
            "HER-TAL-001"
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Finalizar tu Compra 📋"
          },
          {
            "type": "TextInput",
            "name": "nombre_cliente",
            "label": "Nombre Completo",
            "required": true,
            "input-type": "text"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "tipo_entrega",
            "label": "Tipo de Entrega",
            "required": true,
            "data-source": [
              {
                "id": "pickup",
                "title": "📍 Retiro en Sucursal (Gratis)"
              },
              {
                "id": "delivery",
                "title": "🛵 Envío a Domicilio"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "sucursal",
            "label": "Sucursal Retiro",
            "required": false,
            "data-source": [
              {
                "id": "Centro",
                "title": "📍 Centro (Matriz)"
              },
              {
                "id": "Norte",
                "title": "📍 Norte (Av. Eloy Alfaro)"
              },
              {
                "id": "Sur",
                "title": "📍 Sur (Av. Maldonado)"
              },
              {
                "id": "Cumbaya",
                "title": "📍 Cumbayá"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "direccion_entrega",
            "label": "Dirección Entrega",
            "required": false,
            "input-type": "text"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "metodo_pago",
            "label": "Método de Pago",
            "required": true,
            "data-source": [
              {
                "id": "efectivo",
                "title": "💵 Efectivo"
              },
              {
                "id": "transferencia",
                "title": "🏦 Transferencia"
              },
              {
                "id": "tarjeta",
                "title": "💳 Tarjeta Crédito/Débito"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Confirmar Pedido",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "categoria": "${data.categoria}",
                "productos": "${data.productos}",
                "nombre": "${form.nombre_cliente}",
                "tipo_entrega": "${form.tipo_entrega}",
                "sucursal": "${form.sucursal}",
                "direccion": "${form.direccion_entrega}",
                "metodo_pago": "${form.metodo_pago}"
              }
            }
          }
        ]
      }
    }
  ]
}
