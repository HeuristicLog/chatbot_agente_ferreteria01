{$DOMAIN} {
    encode gzip zstd

    # Proxy para el Gateway principal (Webhooks, Catálogo Webview, Métricas y API)
    reverse_proxy whatsapp-gateway:8090 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
